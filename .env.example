PORT=4000
NODE_ENV=development
# Optional. Defaults to ./data/lagos-life.sqlite
# DATABASE_PATH=./data/lagos-life.sqlite
# Optional. Use a mounted persistent volume directory for demo videos and player files.
# PRIVATE_UPLOADS_PATH=/var/data/private-uploads
# Optional moderator username. Sign up with this username to see the moderation queue.
# ADMIN_USERNAME=moderator

# Learning campus publishing and OAuth configuration
# The account with this exact username can upload PDFs and curate the YouTube library.
# ADMIN_USERNAME=learning_admin
# GitHub OAuth App (private repositories, organizations, and in-game GitHub profile editing).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
# GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
# Register this exact callback URL in the GitHub OAuth App settings.
# GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback
# FRONTEND_URL=http://localhost:5173
