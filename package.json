{
  "name": "startup-life",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:server:dev\" \"npm:web:dev\"",
    "server:dev": "tsx watch backend/server/index.ts",
    "web:dev": "vite frontend --config frontend/vite.config.ts",
    "build": "npm run typecheck && vite build frontend --config frontend/vite.config.ts",
    "start": "tsx backend/server/index.ts",
    "preview": "vite preview frontend --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx,css}\" \"backend/server/**/*.ts\" \"frontend/vite.config.ts\" \"frontend/index.html\" \"package.json\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css}\" \"backend/server/**/*.ts\" \"frontend/vite.config.ts\" \"frontend/index.html\" \"package.json\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.2.0",
    "concurrently": "^9.2.0",
    "cookie": "^1.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "vite": "latest"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
